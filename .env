# Application
APP_NAME=Insdustry Document RAG
APP_VERSION=1.0.0

# Logging
LOG_LEVEL=INFO

# API
API_V1_STR=/api/v1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=mistral
OLLAMA_LIGHT_MODEL=llama3.2:1b

# HuggingFace
HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Model Config
MODEL_TIMEOUT=120
MODEL_MAX_RETRIES=3

# Vector Store
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/vectorstore
CHROMA_COLLECTION_NAME=industry_documents
VECTOR_STORE_BATCH_SIZE=100

# Chunking
DOCUMENT_SOURCE_PATH=./data/raw
PROCESSED_DOCS_PATH=./data/processed/chunks
EMBEDDED_DOCS_PATH=./data/processed/embeddings
CHUNK_SIZE=1200
CHUNK_OVERLAP=300
EMBEDDING_BATCH_SIZE=32

# Retrieval
TOP_K_RETRIEVAL=5

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379
CACHE_BACKEND=memory

HF_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_K=3

# Hallucination
HF_HALLUCINATION_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

HALLUCINATION_THRESHOLD=0.75

MAX_REGENERATION_ATTEMPTS=2

# Guardrails

MAX_INPUT_TOKENS=10000

ENABLE_PII_MASKING=true

ENABLE_TOXICITY_FILTER=true

ENABLE_PROMPT_INJECTION_DETECTION=true

# LangSmith

LANGCHAIN_TRACING_V2=true

LANGCHAIN_API_KEY=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

LANGCHAIN_PROJECT=smart-rag-platform

# Memory

MEMORY_WINDOW_SIZE=6

ENABLE_CONVERSATION_SUMMARY=true

SESSION_TTL_MINUTES=60

MAX_MEMORY_TOKENS=1500
